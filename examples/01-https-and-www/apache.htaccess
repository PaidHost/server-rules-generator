# ============================================================
# Generated by the PaidHosting .htaccess, Nginx & Caddy Rule Generator
# Paste this at the TOP of your .htaccess file (WordPress: above the "# BEGIN WordPress" block;
# Laravel: in public/.htaccess, above the existing rewrite rules).
# Works on Apache 2.4+ and LiteSpeed. Back up your existing .htaccess first.
# Reopen or edit this config: https://www.paidhosting.com/htaccess-nginx-generator/?c=v2qiv4&w=strip&t=remove&d=example.com
# ============================================================

# --- Force HTTPS + canonical domain (remove www), combined into a single redirect ---
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>
# Behind Cloudflare or another proxy? %{HTTPS} can read "off" at the origin even
# when the visitor is on HTTPS. If so, replace the first RewriteCond above with:
# RewriteCond %{HTTP:X-Forwarded-Proto} !https [OR]

