# ============================================================
# Generated by the PaidHosting .htaccess, Nginx & Caddy Rule Generator
# Paste this at the TOP of your .htaccess file (WordPress: above the "# BEGIN WordPress" block;
# Laravel: in public/.htaccess, above the existing rewrite rules).
# Works on Apache 2.4+ and LiteSpeed. Back up your existing .htaccess first.
# Reopen or edit this config: https://www.paidhosting.com/htaccess-nginx-generator/?c=hw703k&w=strip&t=remove&d=example.com
# ============================================================

# --- Block bots by User-Agent ---
<IfModule mod_rewrite.c>
RewriteEngine On
# AI training crawlers
RewriteCond %{HTTP_USER_AGENT} (GPTBot|ClaudeBot|anthropic-ai|CCBot|Bytespider|meta-externalagent|FacebookBot|Amazonbot|cohere-training-data-crawler|Diffbot|AI2Bot|omgili|DeepSeekBot|PanguBot|ImagesiftBot|img2dataset|MistralAI-Training) [NC]
RewriteRule ^ - [F,L]
# AI search & assistant fetchers (removes you from their answers)
RewriteCond %{HTTP_USER_AGENT} (OAI-SearchBot|Claude-SearchBot|PerplexityBot|DuckAssistBot|MistralAI-Index|meta-webindexer|Amzn-SearchBot|cohere-ai|Kimi-SearchBot|ChatGPT-User|Claude-User|Perplexity-User|MistralAI-User|meta-externalfetcher|Amzn-User) [NC]
RewriteRule ^ - [F,L]
# SEO / marketing crawlers
RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|BLEXBot|PetalBot|DataForSeoBot|SeekportBot|serpstatbot|MauiBot) [NC]
RewriteRule ^ - [F,L]
# Vulnerability scanners
RewriteCond %{HTTP_USER_AGENT} (nikto|sqlmap|nmap|masscan|zgrab) [NC]
RewriteRule ^ - [F,L]
# Scripting libraries + empty User-Agents (can also block uptime monitors and integrations)
RewriteCond %{HTTP_USER_AGENT} ^$ [OR]
RewriteCond %{HTTP_USER_AGENT} (libwww-perl|python-requests|Go-http-client) [NC]
RewriteRule ^ - [F,L]
</IfModule>
# Google-Extended and Applebot-Extended are robots.txt tokens, not crawlers: see the robots.txt tab.

