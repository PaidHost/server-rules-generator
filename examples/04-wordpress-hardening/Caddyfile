    respond @hidden 403
    @private path *.bak *.conf *.config *.dist *.inc *.ini *.log *.orig *.psd *.save *.sh *.sql *.swo *.swp *~ */composer.json */composer.lock */package.json */package-lock.json */yarn.lock
    respond @private 403

    # WordPress hardening
    @wp_blocked path /xmlrpc.php /wp-config.php   # xmlrpc: breaks Jetpack / XML-RPC apps
    respond @wp_blocked 403
    @uploads_php path_regexp ^/wp-content/uploads/.*\.(php\d?|phtml|phar)$
    respond @uploads_php 403
    @author_scan {
        not path /wp-admin/*
        query author=*
