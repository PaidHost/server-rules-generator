# ============================================================
# Generated by the PaidHosting .htaccess, Nginx & Caddy Rule Generator
# Paste this at the TOP of your .htaccess file (WordPress: above the "# BEGIN WordPress" block;
# Laravel: in public/.htaccess, above the existing rewrite rules).
# Works on Apache 2.4+ and LiteSpeed. Back up your existing .htaccess first.
# Reopen or edit this config: https://www.paidhosting.com/htaccess-nginx-generator/?c=hrcsu8&w=strip&t=remove&d=example.com
# ============================================================

# --- Disable directory listing ---
# If this line causes a 500 error, your host disallows "Options" here: delete it.
Options -Indexes

# --- Protect sensitive files ---
# Deny every dotfile/dotfolder (.env, .git, .htpasswd...) except /.well-known/ (SSL validation)
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule "(^|/)\.(?!well-known/)" - [F]
</IfModule>
# Deny backups, dumps, logs and package manifests
<IfModule mod_authz_core.c>
<FilesMatch "(^#.*#|\.(bak|conf|config|dist|inc|ini|log|orig|psd|save|sh|sql|swo|swp)|~)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|yarn\.lock)$">
    Require all denied
</FilesMatch>
</IfModule>

# --- WordPress hardening ---
<IfModule mod_authz_core.c>
# Blocks XML-RPC (breaks Jetpack and apps that publish through it)
<Files "xmlrpc.php">
    Require all denied
</Files>
<Files "wp-config.php">
    Require all denied
</Files>
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
# No PHP execution inside the uploads folder
RewriteRule ^wp-content/uploads/.*\.(php\d?|phtml|phar)$ - [F,L]
# Block ?author=N username scans on the front end (wp-admin unaffected)
RewriteCond %{REQUEST_URI} !^/wp-admin [NC]
RewriteCond %{QUERY_STRING} (^|&)author=\d+ [NC]
RewriteRule ^ - [F,L]
</IfModule>

