# Note: Caddy forces HTTPS by default. To serve plain HTTP only, prefix the
# site address with http:// (e.g. http://example.com).

example.com, www.example.com {
    # root * /var/www/example.com   (keep your existing root)

    # WebP: serve photo.jpg.webp when it exists and the browser accepts WebP
    @webp {
        header Accept *image/webp*
        path *.jpg *.jpeg *.png
        file {path}.webp
    }
    rewrite @webp {path}.webp
    @images path *.jpg *.jpeg *.png
    header @images Vary Accept

    # php_fastcgi unix//run/php/php-fpm.sock   (keep your existing PHP handler)
    # file_server
}
