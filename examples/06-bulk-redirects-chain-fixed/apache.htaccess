# ============================================================
# Generated by the PaidHosting .htaccess, Nginx & Caddy Rule Generator
# Paste this at the TOP of your .htaccess file (WordPress: above the "# BEGIN WordPress" block;
# Laravel: in public/.htaccess, above the existing rewrite rules).
# Works on Apache 2.4+ and LiteSpeed. Back up your existing .htaccess first.
# Reopen or edit this config: https://www.paidhosting.com/htaccess-nginx-generator/?c=rqve9s&w=strip&t=remove&d=example.com
# ============================================================

# --- Bulk 301 redirects (4) : each goes to its final URL in one hop ---
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^old-page/?$ https://%{HTTP_HOST}/new-page [R=301,L,NE]
RewriteRule ^2019/sale/?$ https://%{HTTP_HOST}/offers [R=301,L,NE]
RewriteRule ^sale/?$ https://%{HTTP_HOST}/offers [R=301,L,NE]
RewriteRule ^about-us\.html/?$ https://%{HTTP_HOST}/about [R=301,L,NE]
</IfModule>

# --- Force HTTPS ---
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
# Behind Cloudflare or another proxy? %{HTTPS} can read "off" at the origin even
# when the visitor is on HTTPS. If so, replace the RewriteCond above with:
# RewriteCond %{HTTP:X-Forwarded-Proto} !https

